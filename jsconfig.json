{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src", // Le dice a TS/VSCode que 'src' es la raíz
    "paths": {
      // Mapea los alias que definiste en vite.config.mjs
      "@/*": ["*"], 
       "api/*": ["api/*"], // 👈 Añade el path para 'api'
      "components/*": ["components/*"],
      "contexts/*": ["contexts/*"],
      "utils/*": ["utils/*"]
    }
  },
  "include": [
    "src/**/*", // <-- Incluye todos tus archivos React
    "vite.config.mjs" // <-- Incluye tu archivo de Vite
  ]
}